+# JP5 even pins are bank 35, powered from VCC1V8 (vendor schematic sheets 1,
+# 5 and 13). N15/N16 in the inherited Pluto constraints are no-connect balls
+# on this board. The AXI SPI chip select is active low during each 32-bit word,
+# so it is the ADF4159's LE signal: low while shifting, rising to latch.
+#                         JP5  net          FPGA ball
+#   pl_spi_clk_o          16    1V8_IO7_P   L14
+#   pl_spi_mosi           18    1V8_IO7_N   L15
+#   pl_spi_le             12    1V8_IO5_P   H16
+#   pl_spi_miso           14    1V8_IO5_N   H17 (optional MUXOUT readback)
+#   adf_txdata             4    1V8_IO1_P   G19 (EMIO GPIO 17)
+set_property -dict {PACKAGE_PIN L14 IOSTANDARD LVCMOS18 DRIVE 8 SLEW SLOW PULLTYPE PULLDOWN} [get_ports pl_spi_clk_o]
+set_property -dict {PACKAGE_PIN L15 IOSTANDARD LVCMOS18 DRIVE 8 SLEW SLOW PULLTYPE PULLDOWN} [get_ports pl_spi_mosi]
+set_property -dict {PACKAGE_PIN H16 IOSTANDARD LVCMOS18 DRIVE 8 SLEW SLOW PULLTYPE PULLUP}   [get_ports pl_spi_le]
+set_property -dict {PACKAGE_PIN H17 IOSTANDARD LVCMOS18} [get_ports pl_spi_miso]
+set_property -dict {PACKAGE_PIN G19 IOSTANDARD LVCMOS18 DRIVE 8 SLEW SLOW PULLTYPE PULLDOWN} [get_ports adf_txdata]
 
 
 create_clock -period 4.000 -name rx_clk [get_ports rx_clk_in_p]
