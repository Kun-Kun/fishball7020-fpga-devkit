-ad_add_decimation_filter "rx_fir_decimator" 8 2 1 {61.44} {61.44} \
+# Both receive channels go through the decimator. Upstream filters channel 0
+# only and sends channel 1 straight to cpack - but cpack captures every enabled
+# channel on channel 0's valid, so the moment decimation engages channel 1 is
+# sampled at one eighth rate with no anti-alias filter of its own. Everything
+# outside +-Fs/16 folds onto it, and it sits offset from channel 0 by the
+# filter's group delay. Harmless on the 1R1T boards this block design also
+# targets; on a 2R2T board it makes the second receiver unusable.
+#
+# An empty STOCK_RX_FILTER= is treated as unset, not as "yes". Exporting a
+# variable with no value is a common accident, and silently building a
+# different bitstream because of one is exactly the kind of surprise this
+# project tries not to hand people.
+set _srf ""
+if {[info exists ::env(STOCK_RX_FILTER)]} { set _srf $::env(STOCK_RX_FILTER) }
+set rx_filt_chan 4
+if {$_srf ne "" && $_srf ne "0"} {
