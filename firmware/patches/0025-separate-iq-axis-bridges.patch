+}
+
 if {$rx_filt_chan == 4} {
   ad_connect cpack/enable_2 rx_fir_decimator/enable_out_2
   ad_connect cpack/fifo_wr_data_2 rx_fir_decimator/data_out_2
@@ -412,6 +474,19 @@ ad_connect  tx_upack/fifo_rd_underflow axi_ad9361/dac_dunf
