 ad_ip_instance util_cpack2 cpack
 
+# Directional I/Q bridges are deliberately independent IP.  Each radio
+# channel gets an iq_axis RX source and an axis_iq TX sink as a custom-DSP
+# attachment point. The legacy cpack/upack DMA paths remain active until an
+# AXIS DSP block supplies the TX source-selection policy.
+ad_ip_instance iq_axis iq_axis_ch0
+ad_ip_instance iq_axis iq_axis_ch1
+ad_ip_instance axis_iq axis_iq_ch0
+ad_ip_instance axis_iq axis_iq_ch1
+
+connect_bd_intf_net [get_bd_intf_pins iq_axis_ch0/m_axis] [get_bd_intf_ports M_AXIS_RX0]
+connect_bd_intf_net [get_bd_intf_pins iq_axis_ch1/m_axis] [get_bd_intf_ports M_AXIS_RX1]
+connect_bd_intf_net [get_bd_intf_pins axis_iq_ch0/s_axis] [get_bd_intf_ports S_AXIS_TX0]
+connect_bd_intf_net [get_bd_intf_pins axis_iq_ch1/s_axis] [get_bd_intf_ports S_AXIS_TX1]
+
 # connections
 
 ad_connect  rx_clk_in_p axi_ad9361/rx_clk_in_p
