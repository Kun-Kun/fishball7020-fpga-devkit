+# Complex-sample AXI4-Stream endpoints for custom in-fabric DSP.  One beat is
+# {Q[15:0], I[15:0]}; both receive streams are masters and both transmit
+# streams are slaves.  They use axi_ad9361/l_clk, not the processor AXI clock.
+create_bd_intf_port -mode Master -vlnv xilinx.com:interface:axis_rtl:1.0 M_AXIS_RX0
+create_bd_intf_port -mode Master -vlnv xilinx.com:interface:axis_rtl:1.0 M_AXIS_RX1
+create_bd_intf_port -mode Slave -vlnv xilinx.com:interface:axis_rtl:1.0 S_AXIS_TX0
+create_bd_intf_port -mode Slave -vlnv xilinx.com:interface:axis_rtl:1.0 S_AXIS_TX1
+set_property CONFIG.TDATA_NUM_BYTES 4 [get_bd_intf_ports S_AXIS_TX0]
+set_property CONFIG.TDATA_NUM_BYTES 4 [get_bd_intf_ports S_AXIS_TX1]
+create_bd_port -dir O -type clk sample_clk
+set_property CONFIG.ASSOCIATED_BUSIF {M_AXIS_RX0:M_AXIS_RX1:S_AXIS_TX0:S_AXIS_TX1} [get_bd_ports sample_clk]
+
 create_bd_port -dir O spi0_csn_2_o
 create_bd_port -dir O spi0_csn_1_o
 create_bd_port -dir O spi0_csn_0_o
@@ -310,6 +322,20 @@ ad_add_decimation_filter "rx_fir_decimator" 8 $rx_filt_chan 1 {61.44} {61.44} \
