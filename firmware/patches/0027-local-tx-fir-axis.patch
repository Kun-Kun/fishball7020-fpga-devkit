 ad_connect  tx_fir_interpolator/active interp_slice/Dout
+ad_connect axi_ad9361/up_dac_gpio_out axis_tx_select_slice/Din
+ad_connect axis_tx_select_slice/Dout axis_tx_interpolator/select_axis
+
+# Bit 2 of up_dac_gpio_out selects the complex AXIS TX source. Zero keeps the
+# DMA/upack path; one selects the interpolated S_AXIS_TX0/1 streams.
+ad_ip_instance util_vector_logic tx_axis_select_n [list \
+  C_OPERATION {not} \
+  C_SIZE 1]
+ad_connect axis_tx_interpolator/select_axis_sync tx_axis_select_n/Op1
+
+# The DMA unpacker must not advance while the AXIS source is selected.
+ad_ip_instance util_vector_logic tx_dma_read_gate [list \
+  C_OPERATION {and} \
+  C_SIZE 1]
+ad_connect logic_or/Res tx_dma_read_gate/Op1
+ad_connect tx_axis_select_n/Res tx_dma_read_gate/Op2
+ad_connect tx_dma_read_gate/Res tx_upack/fifo_rd_en
+
+# Gate custom stream requests so each adapter only consumes beats while its
+# source is selected. The legacy stream remains the power-on default.
+foreach lane {i0 q0 i1 q1} {
+  ad_ip_instance util_vector_logic axis_req_$lane [list \
+    C_OPERATION {and} \
+    C_SIZE 1]
+  ad_connect axi_ad9361/dac_valid_$lane axis_req_$lane/Op1
+  ad_connect axis_tx_interpolator/select_axis_sync axis_req_$lane/Op2
+  ad_connect axis_req_$lane/Res axis_iq_ch[expr {[string index $lane 1]}]/request_[string index $lane 0]
+}
+
+# Select each complex lane independently at the DAC input. Channel zero's
+# legacy data comes from its existing interpolation hierarchy; channel one's
+# legacy data remains the raw upack path.
+foreach lane {i0 q0 i1 q1} {
+  set channel [string index $lane 1]
+  set component [string index $lane 0]
+  create_bd_cell -type module -reference ad_bus_mux tx_dac_${lane}_mux
+  set legacy_data ""
+  if {$channel == 0} {
+    if {$component == "i"} { set legacy_data tx_fir_interpolator/data_out_0 } \
+    else { set legacy_data tx_fir_interpolator/data_out_1 }
+  } else {
+    if {$component == "i"} { set legacy_data tx_upack/fifo_rd_data_2 } \
+    else { set legacy_data tx_upack/fifo_rd_data_3 }
+  }
+  ad_connect $legacy_data tx_dac_${lane}_mux/data_in_0
+  ad_connect axis_iq_ch${channel}/data_${component} tx_dac_${lane}_mux/data_in_1
+  ad_connect axis_tx_interpolator/select_axis_sync tx_dac_${lane}_mux/select_path
+  ad_connect axi_ad9361/dac_enable_${lane} tx_dac_${lane}_mux/enable_in_0
+  ad_connect axi_ad9361/dac_enable_${lane} tx_dac_${lane}_mux/enable_in_1
+  if {$channel == 0} {
+    if {$component == "i"} { set legacy_valid tx_fir_interpolator/valid_out_0 } \
+    else { set legacy_valid tx_fir_interpolator/valid_out_1 }
+  } else {
+    set legacy_valid axi_ad9361/dac_valid_${lane}
+  }
+  ad_connect $legacy_valid tx_dac_${lane}_mux/valid_in_0
+  ad_connect axis_iq_ch${channel}/valid_${component} tx_dac_${lane}_mux/valid_in_1
+  ad_connect tx_dac_${lane}_mux/data_out axi_ad9361/dac_data_${lane}
+}
 
