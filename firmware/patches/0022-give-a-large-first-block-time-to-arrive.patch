 EXPORT_SYMBOL_GPL(cf_axi_dds_tx_starve_arm);
 
+/*
+ * Called when a buffer is enabled, before any block has arrived.
+ *
+ * The first block of a buffer is uploaded AFTER the buffer is enabled: libiio
+ * creates (and enables) the buffer, then pushes the data. A large cyclic
+ * buffer - 4.4 MB for two channels at 40 MS/s, a typical signal-generator
+ * pattern - takes longer than the 250 ms starve timeout to arrive over USB or
+ * a network, so the watchdog muted the transmitter before the data landed,
+ * and the cyclic exemption, which is decided by that first block, never got
+ * the chance to apply. Reported by Akil0515; measured on this board as
+ * "no transmit data for 250 ms" in the kernel log after txbuf.push() at
+ * 2 x 40 MS/s and never at 2 x 38.
+ *
+ * So the first wait is the starve timeout PLUS the time to upload one block at
+ * 1 MB/s, capped at 10 s. A buffer enabled and never fed is still muted -
+ * the case this arming exists for - only later in proportion to its size.
+ * Once a block arrives, cf_axi_dds_tx_starve_arm() takes over unchanged.
+ */
+#define CF_AXI_DDS_TX_FIRST_BLOCK_BYTES_PER_MS	1000	/* 1 MB/s */
+#define CF_AXI_DDS_TX_FIRST_BLOCK_MAX_MS	10000
+
+void cf_axi_dds_tx_starve_arm_first(struct cf_axi_dds_state *st,
+				    unsigned long block_bytes)
+{
+	unsigned int ms = st->tx_starve_ms;
+
+	st->tx_cyclic = false;
+
+	if (!ms) {
+		cancel_delayed_work(&st->tx_starve_work);
+		return;
+	}
+
+	ms += min_t(unsigned long,
+		    block_bytes / CF_AXI_DDS_TX_FIRST_BLOCK_BYTES_PER_MS,
+		    CF_AXI_DDS_TX_FIRST_BLOCK_MAX_MS);
+	st->tx_starve_armed_ms = ms;
+	mod_delayed_work(system_wq, &st->tx_starve_work, msecs_to_jiffies(ms));
+}
+EXPORT_SYMBOL_GPL(cf_axi_dds_tx_starve_arm_first);
+
 void cf_axi_dds_tx_starve_cancel(struct cf_axi_dds_state *st)
 {
 	cancel_delayed_work_sync(&st->tx_starve_work);
