 ad_connect axi_ad9361/adc_enable_i0 rx_fir_decimator/enable_in_0
 ad_connect axi_ad9361/adc_enable_i1 rx_fir_decimator/enable_in_1
 
@@ -383,6 +395,12 @@ ad_connect rx_fir_decimator/enable_out_1 cpack/enable_1
 
 connect_bd_intf_net [get_bd_intf_pins cpack/m_axis] \
   [get_bd_intf_pins axi_ad9361_adc_dma/s_axis]
+ad_ip_instance util_vector_logic rx_overflow_or [list \
