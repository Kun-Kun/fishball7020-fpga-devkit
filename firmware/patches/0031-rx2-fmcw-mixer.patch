 foreach channel {0 1} {
   ad_connect axi_ad9361/adc_enable_i$channel iq_axis_ch$channel/enable_i
   ad_connect axi_ad9361/adc_enable_q$channel iq_axis_ch$channel/enable_q
@@ -369,8 +383,6 @@ foreach channel {0 1} {
 
 connect_bd_intf_net [get_bd_intf_pins iq_axis_ch0/m_axis] \
   [get_bd_intf_pins rx_fir_decimator/s_axis_0]
-connect_bd_intf_net [get_bd_intf_pins iq_axis_ch1/m_axis] \
