 ad_ip_parameter cpack CONFIG.NUM_OF_CHANNELS 2
 
-# RX and TX I/Q bridges convert between the AD9361's parallel sample ports and
-# 32-bit complex AXI streams. The RX cpack DMA path consumes both streams;
-# TX DMA channel 0 passes through the interpolator and channel 1 bypasses it.
+# RX1 reaches the FIR through its I/Q AXIS bridge. RX2 and the conjugated TX2
+# AXIS reference enter Xilinx Complex Multiplier v6.0, whose 16-bit complex
+# output is the FMCW dechirp/beat stream for DMA channel 1. TX DMA channel 0
+# passes through the interpolator and channel 1 bypasses it.
 ad_ip_instance iq_axis iq_axis_ch0
 ad_ip_instance iq_axis iq_axis_ch1
 ad_ip_instance axis_iq axis_iq_ch0
 ad_ip_instance axis_iq axis_iq_ch1
 ad_ip_instance tx_fir_interpolator axis_tx_interpolator
+ad_ip_instance axis_conjugate tx2_conjugate
+ad_ip_parameter tx2_conjugate CONFIG.ENABLE_M_AXIS_TX true
+create_bd_cell -type ip -vlnv xilinx.com:ip:cmpy:6.0 rx2_tx2_cmpy
+set_property -dict [list CONFIG.FlowControl {Blocking} CONFIG.OutputWidth {16}] \
+  [get_bd_cells rx2_tx2_cmpy]
 
 connect_bd_intf_net [get_bd_intf_pins tx_upack/m_axis_0] [get_bd_intf_pins axis_tx_interpolator/s_axis]
 connect_bd_intf_net [get_bd_intf_pins axis_tx_interpolator/m_axis] [get_bd_intf_pins axis_iq_ch0/s_axis]
-connect_bd_intf_net [get_bd_intf_pins tx_upack/m_axis_1] [get_bd_intf_pins axis_iq_ch1/s_axis]
+connect_bd_intf_net [get_bd_intf_pins tx_upack/m_axis_1] [get_bd_intf_pins tx2_conjugate/s_axis]
+connect_bd_intf_net [get_bd_intf_pins tx2_conjugate/m_axis_tx] [get_bd_intf_pins axis_iq_ch1/s_axis]
+connect_bd_intf_net [get_bd_intf_pins iq_axis_ch1/m_axis] [get_bd_intf_pins rx2_tx2_cmpy/S_AXIS_A]
+connect_bd_intf_net [get_bd_intf_pins tx2_conjugate/m_axis_conjugate] [get_bd_intf_pins rx2_tx2_cmpy/S_AXIS_B]
+connect_bd_intf_net [get_bd_intf_pins rx2_tx2_cmpy/M_AXIS_DOUT] [get_bd_intf_pins rx_fir_decimator/s_axis_1]
 
 # connections
 
@@ -355,9 +365,13 @@ ad_connect axi_ad9361/l_clk axis_iq_ch1/clk
 ad_connect axi_ad9361/rst axis_iq_ch1/reset
 ad_connect axi_ad9361/l_clk axis_tx_interpolator/aclk
 ad_connect axi_ad9361/rst axis_tx_interpolator/reset
+ad_connect axi_ad9361/l_clk tx2_conjugate/clk
+ad_connect axi_ad9361/rst tx2_conjugate/reset
+ad_connect axi_ad9361/l_clk rx2_tx2_cmpy/aclk
 ad_connect interp_slice/Dout axis_tx_interpolator/active
 
