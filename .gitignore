# --- Firmware 1 (pluto): upstream source is cloned fresh by setup.sh, not committed ---
firmware/src/

# --- Build outputs (regenerated by build_all.sh in either firmware dir) ---
**/output/*
!**/output/.gitkeep

# --- Vivado / Vitis regeneratable build products (keep real sources, drop caches) ---
**/*.runs/
**/*.gen/
**/*.ip_user_files/
**/*.sim/
**/*.cache/
**/ipcache/
**/.Xil/
**/vivado.jou
**/vivado.log
**/vivado_*.jou
**/vivado_*.log
**/vivado_*.str
**/*.backup.jou
**/*.backup.log
**/webtalk*.jou
**/webtalk*.log
**/*.dcp

**/*.jou
**/*_stdout.log
**/create_project*.log
**/export_hw*.log
**/build.log
**/build_hdl.log
**/aie_primitive.json
**/axi_ad9361_delay.log
**/ip_upgrade*.log
**/ip_upgrade*.rpt
**/*_vivado.log

# Kept intentionally: the final bitstream is small and worth keeping for
# convenience - un-ignore it explicitly since it'd otherwise be caught by
# *.runs/ above.
!**/pluto.runs/impl_1/system_top.bit

# --- OS / editor cruft ---
.DS_Store
*.swp
__pycache__/
firmware/.flash-backups/

# Vivado writes ~/.Xilinx; the container keeps its home here.
firmware/.container-home/

# GRC regenerates this from the .grc every time it opens or runs it.
tools/wifi-scan/fishball_wifi_live.py

# GRC regenerates these from the .grc every time it opens or runs one; the
# .grc is the source. One per flowgraph, plus one module per embedded block.
examples/*/fishball_*.py

# --- Firmware 2 (modern): upstream source is cloned fresh, not committed ---
firmware-modern/src/
# The boot side: U-Boot, embeddedsw, bootgen and the build tree for BOOT.bin (#9).
firmware-modern/boot/

# IQ captures. tools/ and the examples write these wherever they are run from,
# and one second at 61.44 MS/s is 240 MB - three strays at the repo root came to
# 520 MB. Keep them out of git by default; commit a capture deliberately, under
# docs/img/data/, if one is ever worth keeping.
*.sigmf-data
*.sigmf-meta

# verify-modern.yml tees the kernel build here so the warning check can read it.
firmware-modern/build.log

# The Debian rootfs tarball: 300 MB, and build.sh regenerates it from
# packages.txt + the Containerfile + overlay/, which are the things worth
# committing. The tarball itself is also excluded from the BUILD CONTEXT by
# firmware-modern/debian/.dockerignore, or every rebuild would upload its own
# previous output before starting.
firmware-modern/debian/rootfs.tar

# MATLAB scratch: `savefig` with no name lands here and is nobody's deliverable
untitled.fig

# Simulink build products. Generated beside whatever directory you simulate
# from, never by the generators, and never worth committing.
*.slxc
*_cgxe.mexa64
*.slx.autosave
*.slx.r*
slprj/

# Claude Code's per-machine settings. Local to a checkout, not to the project.
.claude/settings.local.json

# mkdocs build output
/site/
