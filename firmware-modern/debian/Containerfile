# The Debian armhf root filesystem for this board.
#
#     # run from: firmware-modern/debian/
#     ./build.sh
#
# Built from the official arm32v7 Debian image rather than debootstrap, for one
# practical reason: the image is signed and pulled from a registry, so an Ubuntu
# host does not need Debian's archive keyring - and Ubuntu 22.04's
# debian-archive-keyring stops at bullseye, so it cannot verify trixie at all.
# apt inside this container is native armhf under qemu-user.
FROM docker.io/arm32v7/debian:trixie

# libiio: Debian trixie ships 0.26, and that is the version this board needs
# whether or not anyone planned it. The board's pinned libiio is 0.25, and
# cyclic transmit - OPEN <dev> <n> <mask> CYCLIC on TCP 30431 - only works in
# libiio's high-speed path, which it enables by probing the legacy
# BLOCK_FREE_IOCTL. Diffing the pinned 0.25 against v0.26 shows local.c, which
# holds both the probe and the cyclic gate, is IDENTICAL; the 27 changed lines
# between them are CI scripts, CMakeLists, serial.c and xml.c. So apt's iiod has
# the same cyclic code, and nothing has to be carried across by hand.
#
# libubootenv-tool, not u-boot-tools, is what provides fw_printenv/fw_setenv on
# a current Debian - u-boot-tools ships only mkimage, dumpimage, mkenvimage and
# friends now. That matters more than it looks: without fw_printenv the board
# cannot read `ethaddr` out of the U-Boot environment, so the macb driver picks a
# random MAC every boot and a DHCP reservation becomes impossible - which is the
# exact problem firmware/patches/0013 exists to fix. It also silently disables the
# tx_quiesce, tx_led, xo_correction and iio_max_block_size environment overrides.
# Found by checking the built image rather than on first boot.
#
# That matters because carrying it across is NOT possible: trixie has no
# libaio1, only libaio1t64, and libaio's ABI genuinely exposes struct timespec
# (io_getevents takes one), so a libaio.so.1 -> libaio.so.1t64 symlink would be
# a real 32/64-bit time_t mismatch rather than a cosmetic rename. The old
# binary's other 13 sonames all resolve; that one does not.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      systemd-sysv udev dbus \
      libiio0 iiod libiio-utils \
      openssh-server \
      ifupdown isc-dhcp-client iproute2 iputils-ping net-tools \
      avahi-daemon libnss-mdns \
      u-boot-tools libubootenv-tool mtd-utils \
      ca-certificates curl less nano psmisc usbutils file bzip2 xz-utils \
      python3 python3-numpy \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# Our own configuration and units, on top.
COPY overlay/ /

RUN set -eux; \
    systemctl enable fishball-rf-quiesce.service; \
    systemctl enable fishball-identity.service; \
    systemctl enable ssh; \
    systemctl enable iiod || true; \
    systemctl enable serial-getty@ttyPS0.service; \
    echo 'root:analog' | chpasswd; \
    echo fishball > /etc/hostname; \
    printf '127.0.0.1\tlocalhost\n127.0.1.1\tfishball\n' > /etc/hosts; \
    chmod 0755 /usr/local/sbin/fishball-rf-quiesce /usr/local/sbin/fishball-identity; \
    rm -f /etc/machine-id; \
    : > /etc/machine-id
