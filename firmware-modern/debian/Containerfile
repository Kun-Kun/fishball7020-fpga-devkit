# The Debian armhf root filesystem for this board.
#
#     # run from: the repo root
#     ./devkit build --target modern --rootfs-only
#
# Built from Debian's official arm32v7 image rather than with debootstrap: the
# image is signed and pulled from a registry, so the host needs no Debian
# archive keyring (Ubuntu 22.04's stops at bullseye and cannot verify trixie).
# apt inside the container runs as native armhf under qemu-user.
#
# PINNED, so two builds of the same commit install the same thing:
#   BASE             the base image, by the digest of its linux/arm/v7 manifest
#   DEBIAN_SNAPSHOT  packages come from snapshot.debian.org at this time, not
#                    from the moving archive. The pinned libiio (see
#                    overlay/etc/apt/preferences.d/fishball-libiio.pref) stays
#                    installable after the archive moves on.
# To move to newer packages, change both, rebuild, and run ./devkit selftest
# --ssh and ./devkit gpio-check on the result.
ARG BASE=docker.io/arm32v7/debian:trixie@sha256:57e5b719e5e07c946222c1d9aaf355f151e91bb2c9c0332dbe7d87cf73cac06f
FROM ${BASE}
ARG BASE
ARG DEBIAN_SNAPSHOT=20260930T000000Z

# What gets installed, and why, is in packages.txt. It is copied into the image
# at /usr/share/fishball/packages.txt so a board says what it was built with.
#
# One RUN, ending in apt-get clean: build.sh exports a flattened filesystem, so
# apt lists left in any layer would ship to every board.
#
# apt reads the snapshot for this install only. The board keeps the normal
# deb.debian.org sources, so `apt update` on the board gets current packages.
# Check-Valid-Until=false because snapshot Release files are past their expiry.
#
# COPY rather than --mount=type=bind: build.sh also supports plain docker,
# where a bind mount needs BuildKit.
COPY packages.txt /usr/share/fishball/packages.txt
RUN set -eu; \
    S=/etc/apt/sources.list.d/debian.sources; \
    cp "$S" /tmp/debian.sources.orig; \
    sed -i -e "s|^URIs: http://deb.debian.org/debian-security\$|URIs: http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}|" \
           -e "s|^URIs: http://deb.debian.org/debian\$|URIs: http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}|" "$S"; \
    grep -q "snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}" "$S"; \
    apt-get -o Acquire::Check-Valid-Until=false update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      $(grep -vE '^[[:space:]]*#|^[[:space:]]*$' /usr/share/fishball/packages.txt); \
    mv /tmp/debian.sources.orig "$S"; \
    apt-get clean; rm -rf /var/lib/apt/lists/*

# The board's own configuration and units.
#
# /etc/hostname and /etc/hosts come from overlay/ because podman and docker
# bind-mount both files during RUN, so a RUN step that writes them never reaches
# the image.
#
# --chown=root:root because rootless podman's COPY keeps the building user's uid
# (1000) on every file and on the directories it touches, /etc included. On the
# board the first user added with adduser gets uid 1000 and would own /etc.
COPY --chown=root:root overlay/ /

# What this image was built from. build.sh passes `git describe` of the repo.
# Declared here, after the package install, because a changed build argument
# invalidates the cache for every later step: declared earlier, each new commit
# reinstalled every package under emulation.
ARG FW_VERSION=unknown

RUN set -eux; \
    # The container image's policy-rc.d stops services starting during a build.
    # On the board it would stop every `apt install` from starting its service.
    rm -f /usr/sbin/policy-rc.d; \
    # The login message is overlay/etc/update-motd.d/10-fishball; Debian's
    # uname line would print above it, and overlay/etc/motd is empty.
    rm -f /etc/update-motd.d/10-uname; \
    # The WiFi regulatory database: Debian defaults to its own copy, signed by a
    # Debian key this kernel does not trust (it trusts only net/wireless/certs:
    # sforshee and wens). The upstream copy is signed by wens.
    update-alternatives --set regulatory.db /lib/firmware/regulatory.db-upstream; \
    # The board has no real-time clock, so it boots with a date before the image
    # was built. The root password's "last changed" date would then be in the
    # future, and PAM refuses it (chage -d 1 below). The same clock makes apt
    # reject Release files as "not valid yet", so timesyncd is enabled here
    # rather than installed on the board.
    systemctl enable systemd-timesyncd.service; \
    systemctl enable fishball-rf-quiesce.service; \
    systemctl enable fishball-identity.service; \
    systemctl enable fishball-usb-gadget.service; \
    systemctl enable fishball-usb-bind.service; \
    # A login console on the USB cable, next to the network at 192.168.2.1.
    systemctl enable serial-getty@ttyGS0.service; \
    systemctl enable ssh; \
    systemctl enable fishball-sshd-keygen.service; \
    systemctl enable iiod || true; \
    systemctl enable serial-getty@ttyPS0.service; \
    echo 'root:analog' | chpasswd; \
    chage -d 1 root; \
    chmod 0755 /usr/local/sbin/fishball-rf-quiesce /usr/local/sbin/fishball-identity; \
    # No identity in the image: it is a release asset, so anything here is on
    # every board flashed from it.
    #
    # SSH host keys made during the build would be one private key shared by
    # every board, downloadable from the releases page. Delete them;
    # fishball-sshd-keygen.service makes new ones on first boot.
    rm -f /etc/ssh/ssh_host_*; \
    # An empty, present /etc/machine-id marks the first boot. dbus's copy points
    # at it instead of keeping the container's id.
    rm -f /var/lib/dbus/machine-id; \
    ln -sf /etc/machine-id /var/lib/dbus/machine-id; \
    rm -f /etc/machine-id; \
    : > /etc/machine-id; \
    # /opt/VERSIONS: what was built, from what, and every installed package at
    # its exact version. fishball-identity reads the device-fw line into
    # fw_version and fw_build.
    mkdir -p /opt; \
    { echo "device-fw ${FW_VERSION}"; \
      echo "debian $(. /etc/os-release; echo "$VERSION_ID") armhf"; \
      echo "base ${BASE}"; \
      echo "snapshot ${DEBIAN_SNAPSHOT}"; \
      echo "built $(date -u +%Y-%m-%dT%H:%M:%SZ)"; \
      echo "#"; \
      echo "# every installed package, from dpkg-query -W:"; \
      dpkg-query -W -f='${Package} ${Version}\n' | sort; \
    } > /opt/VERSIONS
