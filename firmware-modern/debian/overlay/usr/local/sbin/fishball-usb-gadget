#!/bin/sh
# Build the USB composite gadget: a network interface at 192.168.2.1, a serial
# console, and libiio over USB. Replaces the gadget half of Buildroot's S23udc.
#
# This is the board's route in that does not depend on Ethernet, DHCP or
# interface naming, so a broken network configuration still leaves it reachable
# at 192.168.2.1.
#
# Created here and bound separately (fishball-usb-bind), in the factory order:
# create the gadget, start iiod on the FunctionFS, then attach to the UDC.
# Binding before iiod serves it gives the host a device that does not answer.
set -u
CONFIGFS=/sys/kernel/config
G=$CONFIGFS/usb_gadget/composite_gadget

# The factory IDs. Host tools that match on idVendor/idProduct (SDRangel,
# libiio's usb backend) do not see the board otherwise.
VID=0x0456
PID=0xb673
PRODUCT="PlutoSDR (ADALM-PLUTO)"
NETFUNC=${USB_ETHERNET_MODE:-rndis.0}

mountpoint -q $CONFIGFS || mount -t configfs configfs $CONFIGFS 2>/dev/null
[ -d $CONFIGFS/usb_gadget ] || { echo "no configfs usb_gadget support" >&2; exit 1; }
[ -d "$G" ] && { echo "gadget already present"; exit 0; }

serial=$(cat /mnt/jffs2/hw_serial 2>/dev/null)
[ -n "$serial" ] || { echo "no /mnt/jffs2/hw_serial - fishball-identity should have minted one" >&2; exit 1; }

# Both MACs are derived from sha1(hw_serial) exactly as the factory S23udc does.
# The host names its interface enx<host_addr> (the PC end, not the board's
# dev_addr), so a different derivation renames it and breaks any static address
# or NetworkManager profile bound to the old name. hw_serial persists in
# /mnt/jffs2, so the name is stable across reflashes.
s=$(printf '%s\n' "$serial" | sha1sum | cut -c1-12)
hex() { echo "$s" | cut -c"$1"-"$2"; }
host_addr="00:E0:22:$(hex 1 2):$(hex 3 4):$(hex 5 6)"
dev_addr="00:05:F7:$(hex 7 8):$(hex 9 10):$(hex 11 12)"

mkdir -p "$G" || exit 1
echo $VID > "$G/idVendor"
echo $PID > "$G/idProduct"
mkdir -p "$G/strings/0x409"
echo "Analog Devices Inc." > "$G/strings/0x409/manufacturer"
echo "$PRODUCT"           > "$G/strings/0x409/product"
echo "$serial"            > "$G/strings/0x409/serialnumber"

mkdir -p "$G/functions/$NETFUNC" "$G/functions/acm.usb0" "$G/functions/ffs.iio_ffs"
echo "$host_addr" > "$G/functions/$NETFUNC/host_addr"
echo "$dev_addr"  > "$G/functions/$NETFUNC/dev_addr"

mkdir -p "$G/configs/c.1/strings/0x409"
echo "RNDIS/ACM/IIOUSBD" > "$G/configs/c.1/strings/0x409/configuration"
echo 500 > "$G/configs/c.1/MaxPower"
for f in "$NETFUNC" acm.usb0; do
    ln -sf "$G/functions/$f" "$G/configs/c.1/" 2>/dev/null
done
ln -sf "$G/functions/ffs.iio_ffs" "$G/configs/c.1/ffs.iio_ffs" 2>/dev/null

# FunctionFS is where iiod serves libiio over USB. It must be mounted before iiod
# starts, hence Before=iiod.service on this unit.
mkdir -p /dev/iio_ffs
mountpoint -q /dev/iio_ffs || mount -t functionfs iio_ffs /dev/iio_ffs 2>/dev/null

# Print host_addr, in lower case, as the PC's interface name (enx<mac>);
# dev_addr is the board's end and never appears on the PC.
echo "fishball-usb-gadget: created, dev_addr $dev_addr, host_addr $host_addr (your PC sees enx$(echo "$host_addr" | tr -d ':' | tr 'A-Z' 'a-z'))"
