#!/bin/sh
# Start iiod, serving USB as well as the network IF the gadget is there.
#
# THE POINT IS THE "IF". The factory runs one iiod with both -D (network) and
# -F (USB functionfs). Putting `-F /dev/iio_ffs` straight into /etc/default/iiod
# would copy that - and would also mean that any failure to set up the USB gadget
# takes IIOD DOWN COMPLETELY, because iiod cannot open the endpoint and exits. The
# network daemon every host tool depends on would then be hostage to the fallback
# route, which is exactly backwards.
#
# So decide at start time. No gadget: a plain network iiod, which is what Debian
# ships and is known good. Gadget present: both, as the factory does.
set -u
OPTS=""
[ -e /dev/iio_ffs/ep0 ] && OPTS="-F /dev/iio_ffs -n 3"
[ -n "$OPTS" ] && echo "fishball-iiod: serving USB as well ($OPTS)" \
              || echo "fishball-iiod: network only - no USB gadget present"
exec /usr/sbin/iiod $OPTS ${IIOD_EXTRA_OPTS:-}
