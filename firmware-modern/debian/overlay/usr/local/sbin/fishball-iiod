#!/bin/sh
# Start iiod, serving USB as well as the network if the USB gadget exists.
#
# The factory runs iiod with -F (USB FunctionFS) unconditionally. If the gadget
# is missing, iiod cannot open the endpoint and exits, taking the network daemon
# down with it. So decide at start time: no gadget, network only; gadget
# present, both.
set -u
OPTS=""
[ -e /dev/iio_ffs/ep0 ] && OPTS="-F /dev/iio_ffs -n 3"
[ -n "$OPTS" ] && echo "fishball-iiod: serving USB as well ($OPTS)" \
              || echo "fishball-iiod: network only - no USB gadget present"
exec /usr/sbin/iiod $OPTS ${IIOD_EXTRA_OPTS:-}
