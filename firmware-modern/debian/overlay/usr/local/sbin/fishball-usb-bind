#!/bin/sh
# Attach the gadget to the USB controller, and give usb0 its address.
#
#   fishball-usb-bind            wait (up to 10 s) for iiod's FunctionFS, then converge
#   fishball-usb-bind --no-wait  converge on what is true right now (iiod just stopped)
#
# CONVERGE, DO NOT ASSUME. The gadget has two correct states, and this makes the
# bound gadget match whichever one is true NOW - run at boot, after every iiod
# start (its ExecStartPost) and after every iiod stop (its ExecStopPost):
#
#   iiod serving FunctionFS (/dev/iio_ffs/ep1 exists)  -> bound WITH ffs.iio_ffs
#   iiod not serving                                    -> bound WITHOUT it
#
# Why both, and why every time: an unserved FunctionFS function makes the WHOLE
# gadget unbindable (EIO), so without the second state usb0 and the USB console go
# down with iiod. And iiod is held back on purpose - it Requires= the boot TX
# quiesce - so "iiod not running" must still leave a way in. An earlier version
# exited early on "already bound"; then stopping the quiesce (which stops iiod,
# which drops the gadget) or a late iiod left USB down, or USB libiio missing,
# until a reboot. Moving between the two states means unbind, relink, bind, which
# drops usb0 for a moment - the same drop an iiod restart always caused.
set -u
G=/sys/kernel/config/usb_gadget/composite_gadget
C="$G/configs/c.1"
[ -d "$G" ] || { echo "no gadget to bind" >&2; exit 0; }
WAIT=1
[ "${1:-}" = "--no-wait" ] && WAIT=0

# ci_hdrc.0 is the ChipIdea controller on this SoC. Take whatever the kernel
# actually offers rather than hard-coding it, so a device-tree change does not
# silently leave the gadget unbound.
udc=$(ls /sys/class/udc 2>/dev/null | head -1)
[ -n "$udc" ] || { echo "no UDC available" >&2; exit 1; }

# WAIT FOR FUNCTIONFS TO BE READY. A FunctionFS function is not bindable until
# its userspace daemon has written the descriptors to ep0 - until then the UDC
# write fails with EIO:
#
#     /usr/local/sbin/fishball-usb-bind: 19: echo: echo: I/O error
#     failed to bind ci_hdrc.0
#
# `After=iiod.service` does NOT cover this: systemd considers a simple service
# started the moment it has forked. iiod creates ep1.. once it has written the
# descriptors, so that is the signal.
if [ "$WAIT" = 1 ] && [ -d /dev/iio_ffs ]; then
    i=0
    while [ $i -lt 100 ]; do
        [ -e /dev/iio_ffs/ep1 ] && break
        i=$((i + 1)); sleep 0.1
    done
fi
want_ffs=0; [ -e /dev/iio_ffs/ep1 ] && want_ffs=1
have_ffs=0; [ -L "$C/ffs.iio_ffs" ] && have_ffs=1
# NOT `[ -s "$G/UDC" ]`: an UNBOUND UDC file still contains a newline, so -s is
# true. Test the contents.
bound=$(cat "$G/UDC" 2>/dev/null)

if [ -n "$bound" ] && [ "$want_ffs" = "$have_ffs" ]; then
    echo "fishball-usb-bind: already bound to $bound, $( [ $have_ffs = 1 ] && echo with || echo without) USB libiio - nothing to do"
    exit 0
fi

# Unbind first: configfs will not change a bound configuration.
[ -n "$bound" ] && echo "" > "$G/UDC" 2>/dev/null
if [ "$want_ffs" = 1 ]; then
    [ "$have_ffs" = 1 ] || ln -sf "$G/functions/ffs.iio_ffs" "$C/ffs.iio_ffs"
else
    rm -f "$C/ffs.iio_ffs"
    echo "fishball-usb-bind: iiod is NOT serving - binding WITHOUT USB libiio so usb0 and" >&2
    echo "fishball-usb-bind: the console still come up. Why: journalctl -b -u fishball-rf-quiesce -u iiod" >&2
fi

# Retry the write: even with ep1 present the controller can be momentarily busy,
# and one EIO should not cost the board its second route in.
bound_ok=0
i=0
while [ $i -lt 10 ]; do
    if echo "$udc" > "$G/UDC" 2>/dev/null; then bound_ok=1; break; fi
    i=$((i + 1)); sleep 0.5
done
[ "$bound_ok" = "1" ] || { echo "failed to bind $udc after 10 tries" >&2; exit 1; }
echo "fishball-usb-bind: bound to $udc, $( [ $want_ffs = 1 ] && echo with || echo without) USB libiio"

# usb0 appears only once the gadget is bound, so it cannot be an `auto` stanza in
# /etc/network/interfaces - ifupdown runs long before this.
for i in $(seq 1 50); do
    [ -d /sys/class/net/usb0 ] && break
    sleep 0.1
done
if [ -d /sys/class/net/usb0 ]; then
    ip addr add 192.168.2.1/24 dev usb0 2>/dev/null
    ip link set usb0 up
    echo "fishball-usb-bind: usb0 up at 192.168.2.1"
else
    echo "fishball-usb-bind: usb0 never appeared" >&2
fi
