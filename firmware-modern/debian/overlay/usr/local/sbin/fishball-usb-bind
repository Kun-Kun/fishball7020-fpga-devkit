#!/bin/sh
# Attach the gadget to the USB controller, and give usb0 its address.
#
#   fishball-usb-bind            wait (up to 10 s) for iiod's FunctionFS, then converge
#   fishball-usb-bind --no-wait  converge on what is true right now (iiod just stopped)
#
# Runs at boot, after every iiod start (ExecStartPost) and after every iiod stop
# (ExecStopPost), and makes the bound gadget match the current state:
#
#   iiod serving FunctionFS (/dev/iio_ffs/ep1 exists)  -> bound WITH ffs.iio_ffs
#   iiod not serving                                    -> bound WITHOUT it
#
# An unserved FunctionFS function makes the whole gadget fail to bind (EIO), so
# without the second state usb0 and the USB console go down with iiod. iiod is
# held back when the boot TX quiesce fails (it Requires= it), and USB must still
# work then. Switching states means unbind, relink, bind, which drops usb0 briefly.
set -u
G=/sys/kernel/config/usb_gadget/composite_gadget
C="$G/configs/c.1"
[ -d "$G" ] || { echo "no gadget to bind" >&2; exit 0; }
WAIT=1
[ "${1:-}" = "--no-wait" ] && WAIT=0

# The UDC is ci_hdrc.0 (ChipIdea) on this SoC. Use whatever the kernel offers
# rather than hard-coding it, so a device-tree change does not break binding.
udc=$(ls /sys/class/udc 2>/dev/null | head -1)
[ -n "$udc" ] || { echo "no UDC available" >&2; exit 1; }

# Wait for FunctionFS to be ready. It cannot be bound until iiod has written its
# descriptors to ep0; before that the UDC write fails with EIO. After=iiod.service
# does not cover this, since a simple service counts as started once forked.
# iiod creates ep1 after writing the descriptors, so wait for ep1.
if [ "$WAIT" = 1 ] && [ -d /dev/iio_ffs ]; then
    i=0
    while [ $i -lt 100 ]; do
        [ -e /dev/iio_ffs/ep1 ] && break
        i=$((i + 1)); sleep 0.1
    done
fi
want_ffs=0; [ -e /dev/iio_ffs/ep1 ] && want_ffs=1
have_ffs=0; [ -L "$C/ffs.iio_ffs" ] && have_ffs=1
# Not `[ -s "$G/UDC" ]`: an unbound UDC file still contains a newline.
bound=$(cat "$G/UDC" 2>/dev/null)

if [ -n "$bound" ] && [ "$want_ffs" = "$have_ffs" ]; then
    echo "fishball-usb-bind: already bound to $bound, $( [ $have_ffs = 1 ] && echo with || echo without) USB libiio - nothing to do"
    exit 0
fi

# Unbind first: configfs will not change a bound configuration.
[ -n "$bound" ] && echo "" > "$G/UDC" 2>/dev/null
if [ "$want_ffs" = 1 ]; then
    [ "$have_ffs" = 1 ] || ln -sf "$G/functions/ffs.iio_ffs" "$C/ffs.iio_ffs"
else
    rm -f "$C/ffs.iio_ffs"
    echo "fishball-usb-bind: iiod is NOT serving - binding WITHOUT USB libiio so usb0 and" >&2
    echo "fishball-usb-bind: the console still come up. Why: journalctl -b -u fishball-rf-quiesce -u iiod" >&2
fi

# Retry: even with ep1 present the bind can fail transiently with EIO, and
# USB is the board's fallback route in.
bound_ok=0
i=0
while [ $i -lt 10 ]; do
    if echo "$udc" > "$G/UDC" 2>/dev/null; then bound_ok=1; break; fi
    i=$((i + 1)); sleep 0.5
done
[ "$bound_ok" = "1" ] || { echo "failed to bind $udc after 10 tries" >&2; exit 1; }
echo "fishball-usb-bind: bound to $udc, $( [ $want_ffs = 1 ] && echo with || echo without) USB libiio"

# usb0 appears only once the gadget is bound, so it cannot be an `auto` stanza in
# /etc/network/interfaces - ifupdown runs long before this.
for i in $(seq 1 50); do
    [ -d /sys/class/net/usb0 ] && break
    sleep 0.1
done
if [ -d /sys/class/net/usb0 ]; then
    ip addr add 192.168.2.1/24 dev usb0 2>/dev/null
    ip link set usb0 up
    echo "fishball-usb-bind: usb0 up at 192.168.2.1"
else
    echo "fishball-usb-bind: usb0 never appeared" >&2
fi
