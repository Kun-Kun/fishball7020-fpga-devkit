#!/bin/sh
# Generate the board identity at boot: the persistent serial, /etc/libiio.ini,
# xo_correction, the TX LED trigger and the IIO DMA block-size limit. Replaces
# the non-transmitter parts of Buildroot's S21misc and S23udc (the TX mute is
# fishball-rf-quiesce, which runs earlier).
#
#   /etc/libiio.ini    read by libiio at context creation and served as context
#                      attributes. tools/selftest/sdr_selftest.py and the MCP
#                      server read hw_model, hw_serial and fw_version from it.
#                      Without it the board is anonymous and the self-test
#                      cannot compare against its baseline.
#
#   /mnt/jffs2/hw_serial   the serial, created once and kept across reflashes.
#                      It seeds the USB gadget MACs, which fix the host's
#                      enx<mac> interface name. Never regenerate it: tools that
#                      keep baselines would see a different board.
set -u
JFFS2=/mnt/jffs2
INI=/etc/libiio.ini

phy=
for d in /sys/bus/iio/devices/iio:device*; do
    [ -r "$d/name" ] || continue
    [ "$(cat "$d/name")" = "ad9361-phy" ] && phy="$d"
done

# --- the serial: created once, then never again --------------------------
serial=
if [ -r "$JFFS2/hw_serial" ]; then
    serial=$(cat "$JFFS2/hw_serial")
elif [ -w "$JFFS2" ]; then
    # Mix in /proc/cpuinfo where available so two boards do not collide;
    # otherwise urandom alone.
    if [ -r /sys/bus/iio/devices/iio:device1/in_voltage_vccint_raw ] && [ -r /proc/cpuinfo ]; then
        serial=$( { cat /proc/cpuinfo; head -c 32 /dev/urandom; } | md5sum | cut -d' ' -f1)
    else
        serial=$(head -c 32 /dev/urandom | md5sum | cut -d' ' -f1)
    fi
    echo "$serial" > "$JFFS2/hw_serial" && sync
    echo "fishball-identity: minted hw_serial $serial"
else
    echo "fishball-identity: $JFFS2 not writable - no persistent serial" >&2
fi

# --- xo_correction, from the U-Boot environment -------------------------
xo=$(fw_printenv -n xo_correction 2>/dev/null || true)
if [ -n "$xo" ] && [ -n "$phy" ] && [ -w "$phy/xo_correction" ]; then
    echo "$xo" > "$phy/xo_correction"
fi

# --- the context attributes ---------------------------------------------
model=$(sed -n 's/^OF: fdt: Machine model: //p' /dev/null 2>/dev/null)
[ -z "$model" ] && model=$(tr -d '\0' < /proc/device-tree/model 2>/dev/null)
[ -z "$model" ] && model="FISH Ball PlutoSDR Rev.A (Z7020-AD9361)"
fw=$(sed -n 's/^device-fw //p' /opt/VERSIONS 2>/dev/null | head -1)
[ -z "$fw" ] && fw="debian-$(. /etc/os-release; echo "$VERSION_ID")"

# fw_version carries only the release tag (e.g. v2.0); the full `git describe`
# string goes in fw_build.
#
# MATLAB's ADALM-Pluto support package fails to connect when fw_version has the
# git-describe shape (v2.0-9-g5ae29d94[-dirty]): building its "firmware
# incompatible" warning throws, and the throw aborts the connection. Plain tags
# such as v2.0, v2.0-dirty or v0.39 work. Upstream Pluto firmware also reports a
# plain tag. Nothing in this repository parses fw_version.
fw_release=$(echo "$fw" | sed 's/-[0-9][0-9]*-g[0-9a-f][0-9a-f]*\(-dirty\)\{0,1\}$//')

{
    echo "[Context Attributes]"
    echo "hw_model=$model"
    echo "hw_model_variant=1"
    [ -n "$serial" ] && printf 'hw_serial=%s\n\n' "$serial"
    echo "fw_version=$fw_release"
    [ "$fw" != "$fw_release" ] && echo "fw_build=$fw"
    if [ -n "$phy" ] && [ -r "$phy/xo_correction" ]; then
        echo "ad9361-phy,xo_correction=$(cat "$phy/xo_correction")"
    fi
    echo "ad9361-phy,model=ad9361"
} > "$INI"
echo "fishball-identity: wrote $INI (hw_serial ${serial:-none}, fw_version $fw_release, build $fw)"

# --- the USER LED follows the transmitter (patches/0012) -----------------
# Set here rather than in the device tree so it can change without a reflash
# (fw_setenv tx_led 0 turns it off).
if [ "$(fw_printenv -n tx_led 2>/dev/null)" != "0" ]; then
    led=/sys/class/leds/led0:green
    if [ -w "$led/trigger" ] && grep -q tx-active "$led/trigger"; then
        echo tx-active > "$led/trigger"
    fi
fi

# --- the IIO DMA block-size ceiling -------------------------------------
# 64 MB by default, as the vendor rootfs sets; the kernel default is 16 MB. Host
# streaming throughput depends on buffer size (docs/modulation-and-throughput.md),
# so a low ceiling caps it.
# Test for empty output rather than `|| echo default`: libubootenv's fw_printenv
# exits 0 with empty output for an unset variable.
mbs=$(fw_printenv -n iio_max_block_size 2>/dev/null || true)
[ -n "$mbs" ] || mbs=67108864
p=/sys/module/industrialio_buffer_dma/parameters/max_block_size
# The module can refuse the write even when the file is writable. Not fatal;
# report it instead of a bare shell error.
if [ -w "$p" ]; then
    if ! echo "$mbs" > "$p" 2>/dev/null; then
        echo "fishball-identity: kernel refused max_block_size=$mbs (leaving $(cat "$p" 2>/dev/null))" >&2
    fi
fi
exit 0
