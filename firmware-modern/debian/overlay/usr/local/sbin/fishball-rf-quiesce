#!/bin/sh
# Mute both transmit attenuators before anything can open a transmit buffer, and
# bound how long an unattended cyclic transmit can run.
#
# Transmitter protection, in boot order:
#
#   1. the device tree    adi,tx-attenuation-mdB = 89750, applied near the end of
#                         ad9361_setup() (ad9361.c:5326). The TX quadrature
#                         calibration before it (ad9361.c:5308) transmits by
#                         design, so each power-on emits a few ms at the TX LO.
#                         No software can prevent that; see IDLE-CASES.md.
#   2. this script        sets -89.75 dB on both channels and reads it back,
#                         covering the time until a DMA buffer starts
#   3. the kernel         patches/0004 unmutes when a TX DMA buffer starts and
#                         re-mutes when it stops; patches/0015 mutes if the DAC starves
#
# It only helps if it runs before anything can stream: the unit is
# Before=iiod.service, and iiod Requires= it, so iiod fails closed if this fails.
# iiod is the only process that opens a transmit buffer unprompted.
#
# ADI's default is 10 dB attenuation, about +9 dBm out of a possibly
# unterminated SMA on a board with a power amplifier.
#
# Attenuation only, not the TX LO: the kernel owns muting from here on, and a
# powered-down synthesiser would make a later stream transmit into a dead LO.
#
# Cyclic bound. A cyclic DMA transmit repeats one block in hardware forever
# (docs/block-design.md), and patches/0015 exempts cyclic streams from the
# starve watchdog, so a killed streaming tool leaves the board radiating
# indefinitely. Every streaming tool in this devkit transmits cyclically.
# patches/0015 adds tx_cyclic_timeout_ms, default 0 (off); this sets it to
# 60000 ms (60 s).
#
# Skip the mute with:            fw_setenv tx_quiesce 0
# Skip the cyclic bound with:    fw_setenv tx_cyclic_bound 0
# Use a different bound with:    fw_setenv tx_cyclic_bound 10000
#
# The two switches are separate so that disabling the boot mute does not also
# unbound cyclic transmits.
set -u
DEFAULT_CYCLIC_MS=60000

QUIESCE=1
[ "$(fw_printenv -n tx_quiesce 2>/dev/null)" = "0" ] && QUIESCE=0

CYCLIC_MS=$(fw_printenv -n tx_cyclic_bound 2>/dev/null) || CYCLIC_MS=""
[ -n "$CYCLIC_MS" ] || CYCLIC_MS=$DEFAULT_CYCLIC_MS
case "$CYCLIC_MS" in
    *[!0-9]*) echo "fishball-rf-quiesce: tx_cyclic_bound='$CYCLIC_MS' is not a number;" \
                   "using $DEFAULT_CYCLIC_MS" >&2
              CYCLIC_MS=$DEFAULT_CYCLIC_MS ;;
esac

# Both jobs switched off: say so, so the journal shows this differs from the
# unit never having run.
if [ "$QUIESCE" = "0" ] && [ "$CYCLIC_MS" = "0" ]; then
    echo "fishball-rf-quiesce: tx_quiesce=0 AND tx_cyclic_bound=0 - doing nothing." >&2
    echo "fishball-rf-quiesce: transmitters NOT muted at boot and cyclic transmits" >&2
    echo "fishball-rf-quiesce: NOT bounded. Both were switched off deliberately." >&2
    exit 0
fi

# Wait up to 10 s for the IIO devices this run needs; the drivers are built in
# but may not have probed yet. PHY (ad9361-phy) holds the attenuators; TXDEV
# (cf-ad9361-dds-core-lpc, the TX DMA device) holds the cyclic bound.
PHY=
TXDEV=
i=0
while [ $i -lt 100 ]; do
    for d in /sys/bus/iio/devices/iio:device*; do
        [ -r "$d/name" ] || continue
        case "$(cat "$d/name")" in
            ad9361-phy)            PHY="$d" ;;
            cf-ad9361-dds-core-lpc) TXDEV="$d" ;;
        esac
    done
    { [ "$QUIESCE" = "0" ] || [ -n "$PHY" ]; } &&
    { [ "$CYCLIC_MS" = "0" ] || [ -n "$TXDEV" ]; } && break
    i=$((i + 1))
    sleep 0.1
done

rc=0

# No early exit: failures accumulate in rc so that a missing PHY still lets the
# cyclic bound below be applied.
if [ "$QUIESCE" = "1" ] && [ -z "$PHY" ]; then
    echo "fishball-rf-quiesce: no ad9361-phy after 10 s - CANNOT MUTE" >&2
    rc=1
fi

if [ "$QUIESCE" = "1" ] && [ -n "$PHY" ]; then
    for f in "$PHY/out_voltage0_hardwaregain" "$PHY/out_voltage1_hardwaregain"; do
        [ -w "$f" ] || { echo "fishball-rf-quiesce: $f not writable" >&2; rc=1; continue; }
        echo -89.75 > "$f" || rc=1
    done

    # Read back to confirm the write took effect.
    for f in "$PHY/out_voltage0_hardwaregain" "$PHY/out_voltage1_hardwaregain"; do
        v=$(cat "$f" 2>/dev/null)
        case "$v" in
            -89.75*) ;;
            *) echo "fishball-rf-quiesce: $f reads $v, wanted -89.75" >&2; rc=1 ;;
        esac
    done
    [ $rc -eq 0 ] && echo "fishball-rf-quiesce: both transmitters at -89.75 dB"
elif [ "$QUIESCE" = "0" ]; then
    echo "fishball-rf-quiesce: tx_quiesce=0, transmitters NOT muted by this script"
fi
# The PHY-missing case is reported above with rc=1; it must not reach the
# "tx_quiesce=0" message, which means the operator disabled the mute.

if [ "$CYCLIC_MS" != "0" ]; then
    A="$TXDEV/tx_cyclic_timeout_ms"
    if [ -z "$TXDEV" ]; then
        echo "fishball-rf-quiesce: no cf-ad9361-dds-core-lpc after 10 s -" \
             "CYCLIC TRANSMITS ARE UNBOUNDED" >&2
        rc=1
    elif [ ! -w "$A" ]; then
        # A kernel without patches/0015 has no such attribute: warn, do not fail.
        echo "fishball-rf-quiesce: $A not present - this kernel has no cyclic" \
             "bound, so an unattended cyclic transmit runs until power is cut" >&2
    else
        echo "$CYCLIC_MS" > "$A" 2>/dev/null
        # Read back, same rule as the attenuators.
        v=$(cat "$A" 2>/dev/null)
        if [ "$v" = "$CYCLIC_MS" ]; then
            echo "fishball-rf-quiesce: cyclic transmits bounded at ${v} ms"
        else
            echo "fishball-rf-quiesce: $A reads '${v:-unreadable}', wanted" \
                 "$CYCLIC_MS - CYCLIC TRANSMITS MAY BE UNBOUNDED" >&2
            rc=1
        fi
    fi
else
    echo "fishball-rf-quiesce: tx_cyclic_bound=0, cyclic transmits NOT bounded"
fi

exit $rc
