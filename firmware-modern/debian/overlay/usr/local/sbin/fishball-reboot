#!/bin/sh
# Reboot or power off this board without logind.
#
#   fishball-reboot            reboot
#   fishball-reboot poweroff   halt instead
#
# systemd-logind is masked (see
# /etc/systemd/system/systemd-logind.service.d/fishball.conf), so
# `systemctl reboot`, `systemctl --force reboot` and
# `systemctl start reboot.target` all fail with "Unit
# dbus-org.freedesktop.login1.service is masked".
#
# This stops iiod, unmounts the filesystems (above all the FAT /boot holding
# BOOT.bin and the kernel) and then asks the kernel to reboot directly. The
# shutdown is abrupt, but the filesystems are clean.
set -e

# Also installed as `reboot` and `poweroff` symlinks. /usr/local/sbin comes
# before /usr/sbin and /sbin in root's PATH on Debian, so these shadow systemd's
# commands, which would otherwise fail here.
case "$(basename "$0")" in
    poweroff|halt|shutdown) ACTION=poweroff ;;
    *)                      ACTION="${1:-reboot}" ;;
esac

# Stop iiod first: it serves the USB gadget's FunctionFS and holds the radio's
# DMA buffers, and a buffer left held makes the next boot answer -16 EBUSY.
timeout 10 systemctl stop iiod 2>/dev/null || true

sync

# /boot first. FAT has no journal, so an unclean unmount can lose BOOT.bin,
# devicetree.dtb or uImage.
for m in /boot /mnt/jffs2; do
    mountpoint -q "$m" 2>/dev/null || continue
    umount "$m" 2>/dev/null || umount -l "$m" 2>/dev/null || true
done

# Remount the root read-only so ext4 replays nothing on the way back.
mount -o remount,ro / 2>/dev/null || true
sync

# Absolute paths: /usr/local/sbin/reboot is a symlink to this script and comes
# first in PATH, so a bare `reboot -f` would call this script again, endlessly.
# systemd's /usr/sbin/reboot with -f bypasses logind and asks PID 1 directly.
case "$ACTION" in
    poweroff|halt|off) /usr/sbin/poweroff -f 2>/dev/null ;;
    *)                 /usr/sbin/reboot   -f 2>/dev/null ;;
esac

# If that did not work, call the reboot syscall. This kernel has no sysrq, so
# use python3's ctypes, which is already installed.
sleep 5
case "$ACTION" in
    poweroff|halt|off) CMD=0x4321FEDC ;;   # LINUX_REBOOT_CMD_POWER_OFF
    *)                 CMD=0x01234567 ;;   # LINUX_REBOOT_CMD_RESTART
esac
exec python3 -c "import ctypes; ctypes.CDLL('libc.so.6').reboot($CMD)"
