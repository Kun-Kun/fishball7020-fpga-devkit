# /mnt/jffs2 is the only writable persistent partition: QSPI mtd2 ("qspi-nvmfs").
# It holds hw_serial, which must survive every reflash, so it is never
# reformatted. noatime saves NOR flash write cycles.
/dev/mtdblock2  /mnt/jffs2  jffs2  rw,noatime  0 0

# The FAT boot partition (BOOT.bin, uImage, device tree), mounted so
# tools/flash.sh can update it over the network.
LABEL=FISHBOOT  /boot       vfat   defaults,noatime  0 2

# The root, on an SD card. noatime reduces card writes.
# commit=30 bounds how much a hard power cycle can lose: with a long commit
# interval (e.g. 600) freshly written files, such as newly enabled systemd units,
# never reach the card and a power cut discards them without a journal error.
# Run `sync` after deploying anything important.
LABEL=fishroot  /           ext4   defaults,noatime,commit=30,errors=remount-ro  0 1
