[Unit]
Description=Create the USB composite gadget (network, console, libiio over USB)
Documentation=file:///usr/local/sbin/fishball-usb-gadget
After=sysinit.target fishball-identity.service
# iiod serves the functionfs this creates, so it must exist first.
Before=iiod.service
RequiresMountsFor=/mnt/jffs2
# Best effort: the board must still come up on Ethernet if this fails.
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/fishball-usb-gadget
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
