# Generate SSH host keys if the image has none.
#
# The rootfs is a public release asset, so the Containerfile deletes the host
# keys: shipped keys would give every board the same, published private key.
#
# Debian's sshd-keygen.service does the same but is gated on ConditionFirstBoot,
# which depends on /etc/machine-id state at early boot and cannot be tested on a
# running system. Missing keys mean no ssh at all, so this unit checks for the
# key file instead. Both can run: ssh-keygen -A only creates missing keys.
[Unit]
Description=Generate SSH host keys if this image shipped without them
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key
ConditionPathIsReadWrite=/etc/ssh
Before=ssh.service sshd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/ssh-keygen -A

[Install]
WantedBy=ssh.service sshd.service
