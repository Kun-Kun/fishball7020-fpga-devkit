[Unit]
Description=Mute both transmitters before anything can stream
Documentation=file:///usr/local/sbin/fishball-rf-quiesce

# Ordinary dependencies. Do not switch to DefaultDependencies=no with
# Before=sysinit.target: combined with a sysinit.target install that is an
# ordering cycle, and systemd breaks it by deleting this unit's start job.
# Before=iiod.service is the ordering that matters: iiod is the only process
# that opens a transmit buffer unprompted, and it starts in multi-user.target.
After=sysinit.target
Before=iiod.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/fishball-rf-quiesce
# To the console too: if this fails, the transmitter may not be muted.
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
