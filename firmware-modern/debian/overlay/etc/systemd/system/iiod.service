# Replaces the packaged /usr/lib/systemd/system/iiod.service (iiod 0.26-2); a
# unit of the same name in /etc/systemd/system overrides it whole. Two of its
# lines are wrong here, and a drop-in cannot remove either:
#
#   Requires=systemd-udev-settle.service (and After=)
#       deprecated, with a warning at every boot, and unneeded: the IIO drivers
#       are built in and have probed long before multi-user.target. An empty
#       `Requires=` in a drop-in does not reset the dependency list.
#   Environment=$IIOD_EXTRA_OPTS=''
#       an invalid assignment that systemd logs on every load. The drop-in's
#       ExecStart runs /usr/local/sbin/fishball-iiod, which reads ${IIOD_EXTRA_OPTS:-}.
#
# The rest is the package's unit unchanged. Board-specific settings (fail-closed
# Requires= on the TX quiesce, the wrapper, the USB rebind) are in
# iiod.service.d/fishball.conf. If a newer iiod package changes its unit, diff
# it against this one.

[Unit]
Description=IIO Daemon
After=network.target
Documentation=man:iiod(8)
ConditionPathExists=|/sys/bus/iio
ConditionPathExists=|/sys/class/hwmon

[Service]
EnvironmentFile=-/etc/default/iiod
ExecStart=/usr/sbin/iiod $IIOD_EXTRA_OPTS
KillMode=process
Restart=on-failure

[Install]
WantedBy=multi-user.target
