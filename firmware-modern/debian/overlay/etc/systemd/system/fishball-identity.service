[Unit]
Description=Mint the board serial, write /etc/libiio.ini, set the LED trigger
Documentation=file:///usr/local/sbin/fishball-identity
# /etc/libiio.ini must exist before iiod creates its context, or the board
# serves no hw_model/hw_serial and tools cannot tell which unit they talk to.
After=local-fs.target fishball-rf-quiesce.service
Before=iiod.service
RequiresMountsFor=/mnt/jffs2

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/fishball-identity
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
