# Hold libiio at the version this firmware is tested against.
#
# iiod serves every host tool over USB and the network, and libiio's cyclic
# transmit path depends on the kernel's IIO buffer ABI: libiio probes
# BLOCK_FREE_IOCTL and silently falls back to read()/write() when it is absent.
# A libiio that changes this breaks `./devkit gpio-check`, the self-test's
# loopback tone and the MCP transmit tools without any error message.
#
# `src:libiio` covers every binary built from the source package (iiod, libiio0,
# libiio-utils). Priority 1001 makes this the only candidate, which blocks
# upgrades and also allows `apt install libiio0` to downgrade back to it.
#
# To change it: edit the version, rebuild the rootfs
# (./devkit build --target modern --rootfs-only), then run
#   ./devkit selftest --ssh   and   ./devkit gpio-check
# This also blocks security updates for libiio, which suits a board reached over
# a USB cable, not an internet-facing one.

Package: src:libiio
Pin: version 0.26-2
Pin-Priority: 1001
