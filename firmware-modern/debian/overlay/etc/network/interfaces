# Ethernet, matching firmware/patches/0013 on the Buildroot rootfs.
#
# The MAC comes from U-Boot's ethaddr; without it the macb driver picks a random
# MAC every boot and a DHCP reservation is impossible. The hostname line makes
# the DHCP client send option 12, so the router can list the board by name.
auto lo
iface lo inet loopback

# allow-hotplug, not auto: with `auto`, networking.service blocks boot waiting
# for a DHCP lease and blocks shutdown in `ifdown -a` when no cable is plugged
# in. allow-hotplug configures eth0 when udev reports it, which is immediate
# because the MAC is on the SoC.
allow-hotplug eth0
iface eth0 inet dhcp
    hostname fishball
    # `|| true`: a board with no ethaddr in U-Boot still comes up, on a random MAC.
    pre-up ip link set dev $IFACE address "$(fw_printenv -n ethaddr 2>/dev/null)" || true
